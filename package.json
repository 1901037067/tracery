{
  "name": "tracery",
  "version": "1.4.2",
  "description": "Tracery · 仓库型 Markdown 笔记软件（Obsidian 复刻学习版）— 基于 REA 逆向分析 Obsidian 架构后用 Web 技术栈复刻",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "sync": "node sync-server/index.js",
    "test:e2e": "node test/e2e.mjs",
    "test:sync": "node test/sync-test.mjs",
    "test:sync-ui": "node test/sync-ui-test.mjs",
    "test:sync-enc": "node test/sync-enc-test.mjs",
    "upload:github": "node scripts/upload-github.mjs",
    "test:ui": "node test/ui-vault-test.mjs",
    "test:ux": "node test/ui-ux-test.mjs",
    "start:electron": "electron .",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir",
    "dist:dir:nosign": "electron-builder --dir --config.win.signAndEditExecutable=false",
    "repack": "node scripts/repack.mjs",
    "build:cmvendor": "node scripts/build-cmvendor.mjs",
    "release": "node scripts/release.mjs",
    "test:merge": "node test/merge-test.mjs",
    "test:enter": "node test/enter-test.mjs",
    "test:gap": "node test/gap-test.mjs",
    "test:polish": "node test/polish-test.mjs",
    "test:menu": "node test/menu-test.mjs",
    "test:trash": "node test/trash-test.mjs",
    "test:features": "node test/features-test.mjs",
    "test:roundtrip": "node test/roundtrip-test.mjs",
    "test:draw": "node test/draw-test.mjs",
    "test:lan": "node test/lan-test.mjs",
    "test:mdns": "node test/mdns-test.mjs",
    "test:layout": "node test/layout-test.mjs",
    "test:asset": "node test/asset-test.mjs",
    "test:tabs": "node test/tabs-test.mjs",
    "test:pwa": "node test/pwa-mobile-test.mjs",
    "test:performance": "node test/performance-test.mjs",
    "build:pwa-icons": "node scripts/build-pwa-icons.mjs",
    "test:cmlab": "node test/cmlab-test.mjs",
    "test:engine": "node test/engine-test.mjs",
    "test:backspace": "node test/backspace-test.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "node-diff3": "^3.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron/packager": "^18.4.4",
    "@lezer/markdown": "^1.8.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^23.11.1"
  },
  "build": {
    "appId": "com.tracery.app",
    "productName": "Tracery",
    "copyright": "Copyright © 2026 Tracery contributors",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "demo-vault/**/*",
      "sync-server/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Tracery-portable.exe"
    }
  }
}
